NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Optional MongoDB connection string (falls back to persistent file store backend/data/store.json when omitted)
MONGODB_URI=

# JWT Session Configuration
JWT_SECRET=
JWT_EXPIRES_IN=7d

# SMS Gateways (Automas & MimSMS supported; runs in simulated delivery mode when blank)
SMS_ENABLED=true
AUTOMAS_API_KEY=
AUTOMAS_SENDER_ID=RajshahiTour
AUTOMAS_BASE_URL=https://api.automas.com.bd/smsapiv3

MIMSMS_USERNAME=
MIMSMS_API_KEY=
MIMSMS_SENDER_ID=RajshahiTour
MIMSMS_BASE_URL=https://api.mimsms.com

# Use an untracked absolute path for real passenger records; JSON supports one Node process.
# RTT_DATA_FILE=/absolute/path/to/rajshahi/runtime-production.json
# NODE_ENV=production requires a unique JWT_SECRET of at least 32 characters.
# Production disables seeded demo logins and role/password shortcuts.
