NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Optional MongoDB connection string (falls back to persistent file store backend/data/store.json when omitted)
MONGODB_URI=

# JWT Session Configuration
JWT_SECRET=rajshahi-tours-travels-secret-key-2026-secure
JWT_EXPIRES_IN=7d

# SMS Gateways (Automas & MimSMS supported; runs in simulated delivery mode when blank)
SMS_ENABLED=true
AUTOMAS_API_KEY=
AUTOMAS_SENDER_ID=RajshahiTour
AUTOMAS_BASE_URL=https://api.automas.com.bd/smsapiv3

MIMSMS_USERNAME=
MIMSMS_API_KEY=
MIMSMS_SENDER_ID=RajshahiTour
MIMSMS_BASE_URL=https://api.mimsms.com
